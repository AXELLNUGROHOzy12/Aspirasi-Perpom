# ===== Backend (salin jadi backend/.env untuk lokal, atau isi di Railway > Variables) =====
# Isi "production" di Railway. Untuk lokal pakai "development".
NODE_ENV=development
PORT=5000

# Railway mengisi ini otomatis jika kamu "Add Reference" dari service PostgreSQL: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:password@localhost:5432/aspirasi_sma?schema=public"

# Rahasia token sesi admin, minimal 32 karakter acak.
# Buat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8

# Semua alamat frontend (pisahkan dengan koma, tanpa garis miring di akhir)
# Production: https://domain.com,https://www.domain.com,https://admin.domain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cookie sesi admin.
# 'lax'  : bila memakai domain sendiri (domain.com, admin.domain.com, api.domain.com)
# 'none' : hanya bila masih memakai domain bawaan Railway (*.up.railway.app)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ===== SEED OTOMATIS (dijalankan setiap start, aman diulang) =====
SEED_ADMIN_EMAIL=admin@sekolah.test
# Wajib untuk membuat admin pertama, minimal 12 karakter. Setelah admin terbuat, isi ini tidak dipakai lagi.
SEED_ADMIN_PASSWORD=
# true = tambahkan aspirasi dummy (untuk development saja)
SEED_DEMO_DATA=false

# Cloudflare Turnstile. Kosongkan CAPTCHA_SECRET untuk mematikan CAPTCHA.
CAPTCHA_SECRET=
TURNSTILE_SITE_KEY=

# Lampiran. Di Railway pasang Volume lalu arahkan UPLOAD_DIR ke path volume (mis. /data/uploads)
UPLOAD_MAX_SIZE=3145728
UPLOAD_MAX_FILES=3
UPLOAD_DIR=uploads

TRUST_PROXY=1
IP_HASH_SALT=ganti-dengan-string-acak
DAILY_LIMIT_PER_IP=100
TIMEZONE_OFFSET=+07:00

SCHOOL_NAME="SMA Negeri Contoh"
CLASS_LIST="X IPA 1,X IPA 2,X IPS 1,XI IPA 1,XI IPA 2,XI IPS 1,XII IPA 1,XII IPA 2,XII IPS 1"
